{
  "name": "svg-editor-phase1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "cli": "node --import tsx src/cli/main.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json && prettier --check src",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.11"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "prettier": "^3.6.0"
  }
}
